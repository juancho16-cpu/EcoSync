# Evita que se pueda ver la lista de archivos de las carpetas
Options -Indexes

# Desde el navegador solo se puede usar api.php.
# Los demas archivos (conexion, modelos, controladores, configuracion del correo) solo los usa api.php por dentro.
<FilesMatch "\.(php|md|txt|sql)$">
    Require all denied
</FilesMatch>
<Files "api.php">
    Require all granted
</Files>
