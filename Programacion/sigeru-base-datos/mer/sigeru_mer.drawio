        <mxCell id="cpkdHUaZtYSAdXKemp6Q-220" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;RNE:&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;RNE01:&amp;nbsp;&lt;/span&gt;Cada contenedor solo puede guardar un tipo de residuo&lt;br&gt;RNE02:&amp;nbsp;&lt;span data-start=&quot;386&quot; data-end=&quot;443&quot; style=&quot;&quot;&gt;Una incidencia solo puede estar en un estado a la vez&lt;/span&gt; (Abierta, En proceso o Resuelta)&lt;br&gt;RNE03:&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;Un usuario solo puede tener un único rol&lt;/span&gt;&lt;br&gt;RNE04:&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;Solo un administrador puede crear, modificar o eliminar usuarios&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;RNE05:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Un centro de acopio no puede recibir un tipo de residuo que no gestiona&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 19px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;RNE06:&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Una cuadrilla solo puede ser asignada a rutas si tiene camión disponible&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
