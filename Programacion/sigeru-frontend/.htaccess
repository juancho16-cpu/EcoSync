# Evita que se pueda ver la lista de archivos de las carpetas
Options -Indexes

# Cabeceras de seguridad (si Apache tiene el modulo headers)
<IfModule mod_headers.c>
    # El navegador no adivina el tipo de archivo
    Header always set X-Content-Type-Options "nosniff"
    # Ninguna otra pagina puede mostrar SiGeRU dentro de un iframe (evita clickjacking)
    Header always set X-Frame-Options "DENY"
    # No se manda la direccion completa a otros sitios
    Header always set Referrer-Policy "same-origin"
    # El sistema no usa camara ni microfono
    Header always set Permissions-Policy "camera=(), microphone=()"
    # Politica de contenido (CSP): el navegador solo ejecuta los .js del propio sistema.
    # Si alguien logra meter un <script> o un onclick en una pagina, no se ejecuta.
    # Afuera solo se permite: la letra de Google Fonts, el mapa de OpenStreetMap y las rutas de OSRM.
    # Los estilos dentro del HTML se permiten porque Leaflet (el mapa) los necesita.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://tile.openstreetmap.org; connect-src 'self' https://router.project-osrm.org; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
</IfModule>
